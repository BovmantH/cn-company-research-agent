# =============================================================================
# cn-company-research — 环境变量样例
# 复制为 .env 后仅在本机或服务端 Secret 中填写真实值，不提交真实凭证。
# 厂商端点、目录来源、角色默认模型的唯一事实源：
# backend/services/provider_registry.py
# =============================================================================

# -----------------------------------------------------------------------------
# 1) 服务端 LLM 凭证（仅使用 Web 用户 Key 时全部留空）
# -----------------------------------------------------------------------------
# 服务端通过 get_llm(role) 选择一家供应商；不会自动改用其他厂商账户。
# Web 用户临时 Key 只用于本次任务，不写 MongoDB、任务状态、SSE 或应用日志。
# 自动探测顺序：DeepSeek → Kimi → Qwen → GLM → MiniMax → MiMo → OpenRouter → OpenAI。

# 1.1) 国内原厂
# DeepSeek：https://api-docs.deepseek.com/
# 模型与 Search/Fetch 可用同一把 Key；独立搜索和正文提取另按成功请求计费。
DEEPSEEK_API_KEY=

# Kimi：https://platform.kimi.com/docs/models
# 模型与 Search Pro/Fetch 可用同一把 Key；部分新模型有账户解锁条件。
MOONSHOT_API_KEY=

# 阿里百炼：https://help.aliyun.com/zh/model-studio/list-models
# 国内固定端点；Web 可选填 workspace_id 读取业务空间动态目录。
# 未填业务空间时使用推荐清单，workspace_id 不是另一把 Key。
DASHSCOPE_API_KEY=

# 智谱：https://docs.bigmodel.cn/cn/guide/models/text/glm-5.3
# 复用同一 Key 调独立 Web Search；当前使用项目维护的模型推荐清单。
ZAI_API_KEY=

# MiniMax：https://platform.minimax.cn/docs/guides/server-tools
# 普通生成可用；联网 Beta 尚未验证费用次数上限，不开放 Web 联网调研。
MINIMAX_API_KEY=

# 小米 MiMo：https://mimo.mi.com/docs/quick-start/model
# 使用普通按量 API Key；联网需先在厂商控制台开通 Web Search 插件。
MIMO_API_KEY=
# XIAOMI_API_KEY=  # 旧变量名仍兼容，优先使用 MIMO_API_KEY

# 1.2) 聚合 / 海外入口
# OpenRouter：https://openrouter.ai/docs
# 模型路由按官方动态目录选择；免费模型不代表联网搜索免费。
OPENROUTER_API_KEY=

# OpenAI：https://developers.openai.com/api/docs/models
# 当前默认角色模型见注册表；推理模式与采样参数须符合所选模型契约。
OPENAI_API_KEY=

# 1.3) OpenCode Console：仅显式按量选择
# https://opencode.ai/v2/docs/console/api/inference/
# 当前固定聊天基址：https://opencode.ai/inference/openai/v1
# 第三方客户端不能使用其免费聊天模型；没有免费优先或自动付费回退。
# 仅配置本 Key 不会自动选中它，必须同时设置 LLM_VENDOR=opencode。
OPENCODE_API_KEY=

# -----------------------------------------------------------------------------
# 2) 供应商与模型选择
# -----------------------------------------------------------------------------
# 显式选择一家；对应 Key 缺失直接报错。
# 可选：opencode / deepseek / kimi / qwen / glm / minimax / mimo / openrouter / openai
# LLM_VENDOR=deepseek

# 可选覆盖自动探测顺序；未列出的供应商不参与自动选择。
# opencode 不参与自动选择，必须使用 LLM_VENDOR 显式设置。
# 全部名称无效时启动失败，不恢复默认顺序。
# LLM_VENDOR_PRIORITY=deepseek,kimi,qwen,glm,minimax,mimo,openrouter,openai

# 各角色模型仅覆盖当前服务端供应商，不填则读取注册表默认。
# OpenRouter 使用官方带厂商前缀的路由 ID，原厂使用原厂模型 ID。
# 从官方动态目录复制当前可用值，不使用过时的整份静态 slug 速查表。
# Web 用户的模型选择与这些服务端角色变量隔离。
# LLM_MODEL_RESEARCHER=
# LLM_MODEL_BRIEFING=
# LLM_MODEL_EDITOR=

# -----------------------------------------------------------------------------
# 3) 生成与连接参数（可选）
# -----------------------------------------------------------------------------
# 默认不发送温度；新模型可能在推理模式下拒绝 temperature/top_p。
# 确认当前模型接受后再配置；模型参数兼容规则由工厂校验。
# LLM_TEMPERATURE=0.2

# 默认流式；briefing 节点会显式使用非流式。
# LLM_STREAMING=true

# 限制单次生成预算；完整报告还包括其他生成、搜索及提取调用。
# LLM_MAX_TOKENS=4096

# 全局基址覆盖，优先于厂商默认；仅适用于部署者自建兼容网关。
# Web 用户不可提交自定义端点。
# LLM_BASE_URL=http://localhost:8000/v1

# 单厂商基址覆盖，优先级低于全局 LLM_BASE_URL。
# 仅影响该供应商被选中时的服务端模型生成，不改变用户 BYOK 的固定官方端点。
# LLM_BASE_URL_DEEPSEEK=
# LLM_BASE_URL_OPENCODE=
# LLM_BASE_URL_QWEN=
# LLM_BASE_URL_KIMI=
# LLM_BASE_URL_GLM=
# LLM_BASE_URL_MINIMAX=
# LLM_BASE_URL_MIMO=
# LLM_BASE_URL_OPENROUTER=
# LLM_BASE_URL_OPENAI=

# -----------------------------------------------------------------------------
# 4) 部署者模式检索
# -----------------------------------------------------------------------------
# 可选 tavily / deepseek / kimi；默认 tavily。
# SEARCH_PROVIDER=tavily

# 默认 Tavily 需要独立检索 Key；仅用 Web 用户模式可留空。
TAVILY_API_KEY=

# DeepSeek 同 Key 示例（还需上面的 DEEPSEEK_API_KEY）：
# LLM_VENDOR=deepseek
# SEARCH_PROVIDER=deepseek

# Kimi 同 Key 示例（还需上面的 MOONSHOT_API_KEY）：
# LLM_VENDOR=kimi
# SEARCH_PROVIDER=kimi

# DeepSeek/Kimi 每任务最多16次搜索、10次正文提取，共享最多3路并发。
# 正文按URL去重；单页Fetch不是递归抓站。模型token及检索/提取分别计费。
# 这些限制针对本项目发出的请求，不承诺其他厂商托管工具的底层搜索次数。

# -----------------------------------------------------------------------------
# 5) MongoDB 持久化（可选）
# -----------------------------------------------------------------------------
# 不配置时任务状态只驻留内存；配置可持久化任务记录和报告。
# 活动任务/SSE仍为单进程内存，不提供重启恢复或多实例接管。
# MONGODB_URI=mongodb://localhost:27017/cn-research

# -----------------------------------------------------------------------------
# 6) 网络与前端来源（可选）
# -----------------------------------------------------------------------------
# 仅在实际网络访问受限时配置代理，按部署环境选择。
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890

# 多个来源用英文逗号分隔，默认与仓库Vite/Compose的5174端口一致。
# ALLOWED_ORIGINS=http://localhost:5174
