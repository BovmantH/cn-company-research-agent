# =============================================================================
# cn-company-research — 环境变量样例
# -----------------------------------------------------------------------------
# 本文件**仅作为模板**,实际运行请复制为 `.env` 后再填写敏感值。
# 本项目所有 LLM 调用统一走 backend/services/llm_factory.get_llm,
# 检索调用统一走 backend/services/search.get_search_provider。
# =============================================================================


# -----------------------------------------------------------------------------
# 1) 服务端 LLM 凭证(可选:仅使用 Web 用户 Key 时可全部留空)
# -----------------------------------------------------------------------------
# 部署者 Key 只保存在服务端环境变量或 Secret 中,不会下发到浏览器。
# Web 用户可在单次任务中选择厂商、模型并提交自己的临时 Key；该 Key 不读取
# 本节变量、不参与跨供应商回退,也不会写入 MongoDB、任务状态、SSE 或应用日志。
# 当前用户单 Key 原生联网仅开放 Qwen 3.7 Plus / Max；其他厂商目录可查看,
# 但在对应联网适配器完成前不能提交调研任务。
# 配置 OpenCode Zen 后,三个角色优先使用 deepseek-v4-flash-free；同时配置付费
# Key 时,Zen 在首个流式响应块之前发生受控故障才按优先级回退。付费回退会产生费用。
# 未配置 Zen 时,命中的第一家供应商接管所有角色,不会自动跨供应商回退。
# 默认顺序:OpenCode → DeepSeek → Kimi → Qwen → GLM → MiniMax → MiMo → OpenRouter → OpenAI
# 想调整付费顺序见 §2 的 LLM_VENDOR_PRIORITY；想锁死一家见 LLM_VENDOR。


# 1.1) OpenCode Zen 免费优先(可选)
# -----------------------------------------------------------------------------

# OpenCode Zen  https://opencode.ai/docs/zen
#   端点: https://opencode.ai/zen/v1
#   默认 slug: deepseek-v4-flash-free(三个角色相同)
#   ⚠ 该型号为限时免费；Zen 托管在美国,免费期间的数据可能用于模型改进。
#     请勿提交个人、机密或受合同/监管限制的数据。型号和政策可能调整。
OPENCODE_API_KEY=


# 1.2) 国内原厂直连
# -----------------------------------------------------------------------------

# DeepSeek 原厂  https://api-docs.deepseek.com/
#   端点: https://api.deepseek.com
#   默认 slug: researcher/briefing → deepseek-v4-flash,editor → deepseek-v4-pro
DEEPSEEK_API_KEY=

# Moonshot(Kimi)  https://platform.kimi.com/docs/models
#   端点: https://api.moonshot.cn/v1
#   默认 slug: kimi-k3(三个角色相同)
MOONSHOT_API_KEY=

# 阿里百炼(Qwen 兼容模式)
# 文档: https://help.aliyun.com/zh/model-studio/compatibility-of-openai-with-dashscope
#   端点: https://dashscope.aliyuncs.com/compatible-mode/v1(北京);
#         国际站走 https://dashscope-intl.aliyuncs.com/compatible-mode/v1
#   默认 slug: researcher → qwen3.7-flash,briefing → qwen3.7-plus,editor → qwen3.7-max
DASHSCOPE_API_KEY=

# 智谱 GLM  https://docs.bigmodel.cn/cn/guide/develop/openai/introduction
#   端点: https://open.bigmodel.cn/api/paas/v4/
#   默认 slug: researcher → glm-4.7-flash,briefing → glm-4.7,editor → glm-5.2
ZAI_API_KEY=

# MiniMax  https://platform.minimaxi.com/docs/api-reference/text-openai-api
#   端点: https://api.minimaxi.com/v1
#   默认 slug: MiniMax-M3(三个角色相同)
MINIMAX_API_KEY=

# 小米 MiMo  https://api.xiaomimimo.com/
#   端点: https://api.xiaomimimo.com/v1
#   默认 slug: researcher/briefing → mimo-v2.5,editor → mimo-v2.5-pro
#   另有 token plan 充值版端点 https://token-plan-cn.xiaomimimo.com/v1,
#   通过 LLM_BASE_URL_MIMO 切换。
MIMO_API_KEY=
# XIAOMI_API_KEY=  # 旧变量名仍兼容,启动时会提示迁移


# 1.3) 聚合 / 海外供应商(国内通常需要代理)
# -----------------------------------------------------------------------------

# OpenRouter  https://openrouter.ai/
#   一个 key 通几百种模型,model slug 必须带 vendor/ 前缀(如 deepseek/deepseek-v4-flash)
OPENROUTER_API_KEY=

# OpenAI 原生  https://developers.openai.com/api/docs/models
#   默认 slug: researcher → gpt-5.6-luna,briefing → gpt-5.6-terra,editor → gpt-5.6-sol
OPENAI_API_KEY=


# -----------------------------------------------------------------------------
# 2) Vendor 选择策略(可选)
# -----------------------------------------------------------------------------

# 显式锁定供应商,跳过探测和跨供应商回退。
# 可选值:opencode / deepseek / kimi / qwen / glm / minimax / mimo / openrouter / openai
# 锁定后对应 Key 缺失会直接报错,避免账单或合规意外。
# LLM_VENDOR=deepseek

# 自定义付费供应商顺序,逗号分隔；OpenCode 在自动模式下始终优先。
# 未列出的供应商不会参与探测或回退；未知名字会记录警告并跳过。
# 如果所有名字都无效,启动会直接失败,不会静默恢复默认付费顺序。
# LLM_VENDOR_PRIORITY=kimi,deepseek,qwen,glm,minimax,mimo,openrouter,openai


# -----------------------------------------------------------------------------
# 3) 各角色模型选择(可选,不填走代码内默认)
# -----------------------------------------------------------------------------
# - vendor=openrouter 时:slug 必须带 vendor/ 前缀(原样发给 OpenRouter)
# - 其他供应商的 slug 不带前缀,例如 kimi-k3、qwen3.7-max、glm-5.2、gpt-5.6-sol
# - Zen 自动回退模式忽略这些跨供应商模型覆盖,每个候选使用自己的角色默认模型,
#   防止模型名或 Key 串到错误端点。显式锁定供应商时模型覆盖正常生效。

# LLM_MODEL_RESEARCHER=
# LLM_MODEL_BRIEFING=
# LLM_MODEL_EDITOR=


# -----------------------------------------------------------------------------
# 3.1) OpenRouter slug 速查表(核对于 2026-08-10,仅 vendor=openrouter 时生效)
# -----------------------------------------------------------------------------
# 走原厂直连请用各供应商自己的 slug(见 1.2 段落注释)。
#
# DeepSeek:
#   deepseek/deepseek-v4-flash        通用对话,便宜量大
#   deepseek/deepseek-v4-pro          旗舰
#
# 通义千问(Alibaba Qwen):
#   qwen/qwen3.7-plus                 通用长上下文
#   qwen/qwen3.7-max                  旗舰
#
# Moonshot Kimi:
#   moonshotai/kimi-k3                当前通用旗舰
#
# === 推荐组合 ===
#
# A) 全国产 · OpenRouter(只有一个 OpenRouter key 时用):
#   LLM_MODEL_RESEARCHER=deepseek/deepseek-v4-flash
#   LLM_MODEL_BRIEFING=qwen/qwen3.7-plus
#   LLM_MODEL_EDITOR=moonshotai/kimi-k3
#
# B) 全国产 · OpenRouter · 高质量:
#   LLM_MODEL_RESEARCHER=deepseek/deepseek-v4-pro
#   LLM_MODEL_BRIEFING=qwen/qwen3.7-max
#   LLM_MODEL_EDITOR=moonshotai/kimi-k3
#
# C) 原厂直连 · DeepSeek 全包(只配 DEEPSEEK_API_KEY,模型字段全空走默认):
#   # 不需要写任何 LLM_MODEL_*,默认 deepseek-v4-flash 即可
#
# D) Zen 免费优先 + 付费回退:
#   # 配 OPENCODE_API_KEY,再配一至多家付费 Key。
#   # Zen 在首块输出前遇到受控上游故障时,才按 LLM_VENDOR_PRIORITY 回退。
#   # 付费回退可能产生费用,请在各供应商控制台设置预算和自动充值限制。


# -----------------------------------------------------------------------------
# 4) LLM 通用参数(可选)
# -----------------------------------------------------------------------------

# 采样温度。默认不发送该参数,使用各供应商或模型自己的默认值。
# 只有确认目标模型支持时才显式配置。
# LLM_TEMPERATURE=0.2

# 是否启用流式输出,默认 true(briefing 节点会显式覆盖为 false 以减少连接开销)
# LLM_STREAMING=true

# 全局 base_url 覆盖,优先级最高；启用后关闭跨供应商回退,保持单供应商模式。
# 用途:走本地 vLLM / Ollama / LiteLLM,或自建 OpenAI 兼容代理
# 如需保留多供应商回退,请改用下方 LLM_BASE_URL_<VENDOR> 分别配置。
# 示例: LLM_BASE_URL=http://localhost:8000/v1
# LLM_BASE_URL=

# 单 vendor 维度的 base_url 覆盖,仅在该 vendor 被选中时生效。
# 优先级低于全局 LLM_BASE_URL,高于 vendor 默认 base_url。
# 用途:用 OneAPI / LiteLLM 网关只代理某一家原厂。
# LLM_BASE_URL_DEEPSEEK=
# LLM_BASE_URL_OPENCODE=
# LLM_BASE_URL_QWEN=
# LLM_BASE_URL_KIMI=
# LLM_BASE_URL_GLM=
# LLM_BASE_URL_MINIMAX=
# LLM_BASE_URL_MIMO=        # 切到 token plan: https://token-plan-cn.xiaomimimo.com/v1
# LLM_BASE_URL_OPENROUTER=
# LLM_BASE_URL_OPENAI=

# 单次响应 max_tokens 上限(强烈推荐配置)
# OpenRouter 按 max_tokens × 单价预扣费,不设的话会按模型最大窗口
# (数万 token)预扣,贵模型 + 小余额会直接 402 报错。
# 推荐值:4096(够用),报告类长输出可调到 8192。
# LLM_MAX_TOKENS=4096


# -----------------------------------------------------------------------------
# 5) 检索 provider(必填 TAVILY_API_KEY)
# -----------------------------------------------------------------------------

# Tavily API key,Phase 1 默认 provider 必填
# 申请地址: https://tavily.com/
TAVILY_API_KEY=

# 切换检索 provider,默认 `tavily`
# Phase 2 计划新增 `bocha` / `serper` / `zhipu` 等中文友好 provider
# SEARCH_PROVIDER=tavily


# -----------------------------------------------------------------------------
# 6) MongoDB 持久化(可选)
# -----------------------------------------------------------------------------
# 不配置则结果只保留在内存,重启即丢;配置则启用任务/报告持久化。
# 示例: MONGODB_URI=mongodb://localhost:27017
# MONGODB_URI=


# -----------------------------------------------------------------------------
# 7) 网络代理(可选,仅在国内访问 OpenRouter / OpenAI / Tavily 受限时需要)
# -----------------------------------------------------------------------------
# 走原厂直连(DeepSeek / Qwen / Kimi)无需代理。
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890

# 允许访问后端的前端来源，多个来源使用英文逗号分隔。
# 默认值与仓库内 Vite、Docker Compose 的 5174 端口一致。
# ALLOWED_ORIGINS=http://localhost:5174
