# =============================================================================
# cn-company-research — 环境变量样例
# -----------------------------------------------------------------------------
# 本文件**仅作为模板**,实际运行请复制为 `.env` 后再填写敏感值。
# 本项目所有 LLM 调用统一走 backend/services/llm_factory.get_llm,
# 检索调用统一走 backend/services/search.get_search_provider。
# =============================================================================


# -----------------------------------------------------------------------------
# 1) LLM 网关(必填:下面两个 KEY 至少配一个,否则启动会被拒绝)
# -----------------------------------------------------------------------------

# 【主推】OpenRouter API key,用一个 key 通国内外几百种模型
# 申请地址: https://openrouter.ai/
OPENROUTER_API_KEY=

# 【降级】OpenAI 原生 API key
# 仅当 OPENROUTER_API_KEY 未配置时,工厂会自动回落到 https://api.openai.com
# 申请地址: https://platform.openai.com/
OPENAI_API_KEY=


# -----------------------------------------------------------------------------
# 2) 各角色模型选择(可选,不填走代码内默认)
# -----------------------------------------------------------------------------
# 模型字符串遵循 OpenRouter 命名(`vendor/model`)。
# 走 OpenAI 降级路径时,工厂会自动剥离 vendor 前缀(如 `openai/gpt-4o` → `gpt-4o`)。
#
# 默认值(不填时):
#   researcher → deepseek/deepseek-v4-flash   (快、便宜,适合大量并行 query)
#   briefing   → qwen/qwen3.6-flash           (长上下文,适合汇总文档)
#   editor     → moonshotai/kimi-k2.6         (中文产出严谨,适合最终成文)

# LLM_MODEL_RESEARCHER=deepseek/deepseek-v4-flash
# LLM_MODEL_BRIEFING=qwen/qwen3.6-flash
# LLM_MODEL_EDITOR=moonshotai/kimi-k2.6


# -----------------------------------------------------------------------------
# 2.1) 国产模型速查表(OpenRouter slug,2026-05 现状)
# -----------------------------------------------------------------------------
# 任意一个直接填到上面 LLM_MODEL_<ROLE> 即可,代码无需改动。
# OpenRouter 上线了什么 slug,这里就能填什么——slug 会随版本更替,
# 想看最新清单去 https://openrouter.ai/models 搜对应 vendor。
#
# DeepSeek:
#   deepseek/deepseek-v4-flash        通用对话,便宜量大(默认 researcher)
#   deepseek/deepseek-v4-pro          旗舰
#
# 通义千问 (Alibaba Qwen):
#   qwen/qwen3.6-flash                长上下文,稳定(默认 briefing)
#   qwen/qwen3.6-max-preview          旗舰预览
#   qwen/qwen3.6-35b-a3b              中等规模
#
# Moonshot Kimi:
#   moonshotai/kimi-k2.6              262K 上下文,代码强(默认 editor)
#   moonshotai/kimi-k2-thinking       agentic 长链路推理
#
# 小米 MiMo:
#   xiaomi/mimo-v2-pro                MoE,主打吞吐 + 价格
#   xiaomi/mimo-v2.5-pro              新一代
#   xiaomi/mimo-v2-flash              更便宜
#
# 智谱 GLM(OpenRouter 上 vendor 前缀是 z-ai,不是 zhipuai):
#   z-ai/glm-4.5                      开源系,中文友好
#   z-ai/glm-4.6                      新一代,推理增强
#   z-ai/glm-4.7                      最新旗舰
#
# MiniMax:
#   minimax/minimax-m2.7              创意 / 多模态强
#
# === 推荐组合 ===
#
# A) 全国产 · 平衡(默认值,researcher 跑量、briefing 长文、editor 收尾):
#   LLM_MODEL_RESEARCHER=deepseek/deepseek-v4-flash
#   LLM_MODEL_BRIEFING=qwen/qwen3.6-flash
#   LLM_MODEL_EDITOR=moonshotai/kimi-k2.6
#
# B) 全国产 · 高质量(查询 / 汇总都上旗舰,成本翻倍但产出更稳):
#   LLM_MODEL_RESEARCHER=deepseek/deepseek-v4-pro
#   LLM_MODEL_BRIEFING=qwen/qwen3.6-max-preview
#   LLM_MODEL_EDITOR=moonshotai/kimi-k2-thinking
#
# C) 全国产 · 极致便宜(全部用小米 MiMo 跑吞吐):
#   LLM_MODEL_RESEARCHER=xiaomi/mimo-v2-flash
#   LLM_MODEL_BRIEFING=xiaomi/mimo-v2-pro
#   LLM_MODEL_EDITOR=xiaomi/mimo-v2.5-pro


# -----------------------------------------------------------------------------
# 3) LLM 通用参数(可选)
# -----------------------------------------------------------------------------

# 采样温度,默认 0(确定性输出,便于复现)
# LLM_TEMPERATURE=0

# 是否启用流式输出,默认 true(briefing 节点会显式覆盖为 false 以减少连接开销)
# LLM_STREAMING=true

# 自定义 base_url,优先级最高
# 用途:走本地 vLLM / Ollama / LiteLLM,或自建 OpenAI 兼容代理
# 示例:
#   LLM_BASE_URL=http://localhost:8000/v1
# LLM_BASE_URL=

# 单次响应 max_tokens 上限(强烈推荐配置)
# OpenRouter 按 max_tokens × 单价预扣费,不设的话会按模型最大窗口
# (数万 token)预扣,贵模型 + 小余额会直接 402 报错。
# 推荐值:4096(够用),报告类长输出可调到 8192。
# LLM_MAX_TOKENS=4096


# -----------------------------------------------------------------------------
# 4) 检索 provider(必填 TAVILY_API_KEY)
# -----------------------------------------------------------------------------

# Tavily API key,Phase 1 默认 provider 必填
# 申请地址: https://tavily.com/
TAVILY_API_KEY=

# 切换检索 provider,默认 `tavily`
# Phase 2 计划新增 `bocha` / `serper` / `zhipu` 等中文友好 provider
# SEARCH_PROVIDER=tavily


# -----------------------------------------------------------------------------
# 5) MongoDB 持久化(可选)
# -----------------------------------------------------------------------------
# 不配置则结果只保留在内存,重启即丢;配置则启用任务/报告持久化。
# 示例: MONGODB_URI=mongodb://localhost:27017
# MONGODB_URI=


# -----------------------------------------------------------------------------
# 6) 网络代理(可选,仅在国内访问 OpenRouter 受限时需要)
# -----------------------------------------------------------------------------
# OpenRouter / OpenAI / Anthropic / Tavily 在国内访问可能不稳定,可走代理:
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
